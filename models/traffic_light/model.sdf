    <link name="frame"><gravity>false</gravity><inertial><mass>1</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
      <visual name="lamp_housing"><pose>0 0 0.410 0 0 0</pose><geometry><box><size>0.640 0.025 0.140</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual><collision name="lamp_housing_collision"><pose>0 0 0.410 0 0 0</pose><geometry><box><size>0.640 0.025 0.140</size></box></geometry></collision>
