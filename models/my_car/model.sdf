<sdf version='1.7'>
<model name='my_car'>
      <pose>0 0 0 0 0 0</pose>
      <link name='chassis'>
        <pose>0 0 0 0 -0 0</pose>
        <inertial><mass>1.2</mass><inertia><ixx>0.0034</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0063</iyy><iyz>0</iyz><izz>0.0087</izz></inertia><pose>0 0 0 0 -0 0</pose></inertial>
        <collision name='body_collision'><pose>0 0 0.125 0 -0 0</pose><geometry><box><size>0.4 0.28333333 0.11666667</size></box></geometry><max_contacts>10</max_contacts><surface><contact><ode/></contact><bounce/><friction><torsional><ode/></torsional><ode/></friction></surface></collision>
