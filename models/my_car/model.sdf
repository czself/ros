        <visual name='camera_body'><pose>0.14166667 0 0.30833333 0 -0 0</pose><geometry><box><size>0.058333333 0.15 0.05</size></box></geometry><material><ambient>0.08 0.08 0.1 1</ambient><diffuse>0.15 0.16 0.2 1</diffuse><specular>0.7 0.7 0.75 1</specular></material></visual>
