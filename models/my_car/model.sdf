        <visual name='lidar_head'><pose>-0.083333333 0 0.30 0 -0 0</pose><geometry><cylinder><radius>0.046666667</radius><length>0.046666667</length></cylinder></geometry><material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.2 0.21 0.25 1</diffuse></material></visual>
        <visual name='lidar_window'><pose>-0.083333333 0 0.295 0 -0 0</pose><geometry><cylinder><radius>0.0475</radius><length>0.016666667</length></cylinder></geometry><material><ambient>0.05 0.08 0.12 1</ambient><diffuse>0.1 0.2 0.35 1</diffuse><specular>1 1 1 1</specular></material></visual>
