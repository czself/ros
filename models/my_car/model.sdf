        <visual name='lidar_mast'><pose>-0.083333333 0 0.235 0 -0 0</pose><geometry><cylinder><radius>0.013333333</radius><length>0.07</length></cylinder></geometry><material><ambient>0.5 0.08 0.05 1</ambient><diffuse>0.8 0.15 0.1 1</diffuse></material></visual>
