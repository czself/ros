<launch>
  <arg name="explore" default="false" />
  <include file="/root/navigation/robot.launch" />
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen" required="true">
    <remap from="scan" to="/scan" />
    <param name="base_frame" value="base_footprint" />
    <param name="odom_frame" value="odom" />
    <param name="map_frame" value="map" />
    <param name="map_update_interval" value="1.0" />
    <param name="linearUpdate" value="0.10" />
    <param name="angularUpdate" value="0.10" />
    <param name="temporalUpdate" value="1.0" />
    <param name="particles" value="30" />
    <param name="xmin" value="-6.0" /><param name="xmax" value="6.0" />
    <param name="ymin" value="-6.0" /><param name="ymax" value="6.0" />
    <param name="delta" value="0.05" />
    <param name="maxRange" value="8.0" /><param name="maxUrange" value="7.8" />
    <param name="srr" value="0.001" /><param name="srt" value="0.001" />
    <param name="str" value="0.001" /><param name="stt" value="0.001" />
  </node>
  <include file="/root/navigation/planner.launch" if="$(arg explore)" />
</launch>
